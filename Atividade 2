#include <stdio.h>
#include <stdlib.h>

#define QTD 10

// Ordena um vetor em ordem crescente (bubble sort)
void ordenarCrescente(int *vet, int n)
{
    int i, j, aux;

    for (i = 0; i < n - 1; i++)
    {
        for (j = 0; j < n - 1 - i; j++)
        {
            if (vet[j] > vet[j + 1])
            {
                aux = vet[j];
                vet[j] = vet[j + 1];
                vet[j + 1] = aux;
            }
        }
    }
}

void exibir(int *vet, int n)
{
    int i;

    if (n == 0)
        printf("(nenhum valor)");
    for (i = 0; i < n; i++)
        printf("%d ", vet[i]);
    printf("\n");
}

int main()
{
    int i, valor;
    int *posPares, *negImpares;   // vetores dinamicos
    int nPosPares = 0, nNegImpares = 0;

    posPares = (int *) malloc(QTD * sizeof(int));
    negImpares = (int *) malloc(QTD * sizeof(int));
    if (posPares == NULL || negImpares == NULL)
    {
        printf("Erro de memoria!\n");
        return 1;
    }

    for (i = 0; i < QTD; i++)
    {
        printf("Digite o valor %d: ", i + 1);
        scanf("%d", &valor);

        if (valor > 0 && valor % 2 == 0)
        {
            posPares[nPosPares] = valor;
            nPosPares++;
        }
        else if (valor < 0 && valor % 2 != 0)
        {
            negImpares[nNegImpares] = valor;
            nNegImpares++;
        }
        // zero, positivos impares e negativos pares nao entram em nenhum vetor
    }

    ordenarCrescente(posPares, nPosPares);
    ordenarCrescente(negImpares, nNegImpares);

    printf("\nPositivos e pares (ordem crescente): ");
    exibir(posPares, nPosPares);

    printf("Negativos e impares (ordem crescente): ");
    exibir(negImpares, nNegImpares);

    free(posPares);
    free(negImpares);

    return 0;
}
