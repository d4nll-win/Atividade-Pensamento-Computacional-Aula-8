#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

#define N_PART 4
#define MAX_RODADAS 7
#define EPS 1e-9

// ---------- Funcoes auxiliares ----------

// 20! eh o maior fatorial que cabe em 64 bits, por isso a idade eh limitada a 20
unsigned long long fatorial(int n)
{
    unsigned long long r = 1;
    int i;

    for (i = 2; i <= n; i++)
        r *= i;
    return r;
}

unsigned long long potencia(unsigned long long base, int expoente)
{
    unsigned long long r = 1;
    int i;

    for (i = 0; i < expoente; i++)
        r *= base;
    return r;
}

// tentativa 0: fatorial(idade) / 2
// tentativa 1: fatorial(idade / 2) elevado a qtdValores
// tentativa 2, 3...: repete o procedimento com a metade da metade da idade, e assim por diante
unsigned long long gerarId(int idade, int qtdValores, int tentativa)
{
    int metade = idade, k;

    if (tentativa == 0)
        return fatorial(idade) / 2;

    for (k = 0; k < tentativa; k++)
        metade = metade / 2;

    return potencia(fatorial(metade), qtdValores);
}

int existeDuplicado(unsigned long long ids[], int n, int i)
{
    int j;

    for (j = 0; j < n; j++)
    {
        if (j != i && ids[j] == ids[i])
            return 1;
    }
    return 0;
}

// Pesos: 1, 2, 3, ... (primeiro valor tem peso 1)
double mediaPonderada(double *valores, int qtd)
{
    double soma = 0, pesos = 0;
    int j;

    for (j = 0; j < qtd; j++)
    {
        soma += valores[j] * (j + 1);
        pesos += (j + 1);
    }
    return soma / pesos;
}

// Raiz quadrada pelo metodo de Newton (evita depender da biblioteca math)
double raizQuadrada(double x)
{
    double r;
    int i;

    if (x <= 0)
        return 0;
    r = x;
    for (i = 0; i < 100; i++)
        r = (r + x / r) / 2;
    return r;
}

int compararNomes(const char *a, const char *b)
{
    while (*a && *b)
    {
        int ca = tolower((unsigned char)*a);
        int cb = tolower((unsigned char)*b);
        if (ca != cb)
            return ca - cb;
        a++;
        b++;
    }
    return tolower((unsigned char)*a) - tolower((unsigned char)*b);
}

// ---------- Programa principal ----------

int main()
{
    char nomes[N_PART][50];
    int idades[N_PART];
    unsigned long long ids[N_PART];
    int tentativas[N_PART];
    double **valores;          // matriz dinamica: linha = participante, coluna = valor
    int qtd, i, j, rodada;
    int lados = 0, achouDiagonal;
    double ladoRet[2], diagonal = 0, media[N_PART];
    char tmpNome[50], maiusculo[50];
    int tmpIdade, encontrado;
    unsigned long long tmpId;
    double *tmpLinha;
    const char *classe;

    // 1) Cadastro: nome e idade
    for (i = 0; i < N_PART; i++)
    {
        printf("Nome do participante %d: ", i + 1);
        scanf(" %49[^\n]", nomes[i]);
        do
        {
            printf("Idade de %s (1 a 20): ", nomes[i]);
            scanf("%d", &idades[i]);
        } while (idades[i] < 1 || idades[i] > 20);
    }

    // 2) Quantidade de valores e captura (a quantidade eh necessaria para calcular os IDs)
    do
    {
        printf("\nQuantos valores serao registrados para cada participante? ");
        scanf("%d", &qtd);
    } while (qtd < 1);

    valores = (double **) malloc(N_PART * sizeof(double *));
    for (i = 0; i < N_PART; i++)
        valores[i] = (double *) malloc(qtd * sizeof(double));

    for (i = 0; i < N_PART; i++)
    {
        for (j = 0; j < qtd; j++)
        {
            printf("Valor %d de %s: ", j + 1, nomes[i]);
            scanf("%lf", &valores[i][j]);

            // 5) Os dois primeiros valores NAO NEGATIVOS (na ordem de entrada) sao os lados
            if (valores[i][j] >= 0 && lados < 2)
            {
                ladoRet[lados] = valores[i][j];
                lados++;
            }
        }
    }

    // Calculo dos IDs unicos
    for (i = 0; i < N_PART; i++)
    {
        tentativas[i] = 0;
        ids[i] = gerarId(idades[i], qtd, 0);
    }
    for (rodada = 0; rodada < MAX_RODADAS; rodada++)
    {
        int dup[N_PART], houve = 0;

        for (i = 0; i < N_PART; i++)
        {
            dup[i] = existeDuplicado(ids, N_PART, i);
            if (dup[i])
                houve = 1;
        }
        if (!houve)
            break;

        for (i = 0; i < N_PART; i++)
        {
            if (dup[i])
            {
                tentativas[i]++;
                ids[i] = gerarId(idades[i], qtd, tentativas[i]);
            }
        }
    }
    // Garantia final de unicidade (ex.: duas pessoas com a mesma idade geram sempre o mesmo ID)
    for (i = 1; i < N_PART; i++)
    {
        do
        {
            encontrado = 0;
            for (j = 0; j < i; j++)
            {
                if (ids[j] == ids[i])
                {
                    ids[i]++;
                    encontrado = 1;
                    break;
                }
            }
        } while (encontrado);
    }

    // 5) Diagonal do retangulo
    achouDiagonal = (lados == 2);
    if (achouDiagonal)
        diagonal = raizQuadrada(ladoRet[0] * ladoRet[0] + ladoRet[1] * ladoRet[1]);

    // 3) Organiza os participantes em ordem alfabetica (mantendo ID, idade e valores associados)
    for (i = 0; i < N_PART - 1; i++)
    {
        for (j = 0; j < N_PART - 1 - i; j++)
        {
            if (compararNomes(nomes[j], nomes[j + 1]) > 0)
            {
                strcpy(tmpNome, nomes[j]);
                strcpy(nomes[j], nomes[j + 1]);
                strcpy(nomes[j + 1], tmpNome);

                tmpIdade = idades[j];
                idades[j] = idades[j + 1];
                idades[j + 1] = tmpIdade;

                tmpId = ids[j];
                ids[j] = ids[j + 1];
                ids[j + 1] = tmpId;

                tmpLinha = valores[j];   // troca apenas os ponteiros das linhas
                valores[j] = valores[j + 1];
                valores[j + 1] = tmpLinha;
            }
        }
    }

    // 4) Media ponderada
    for (i = 0; i < N_PART; i++)
        media[i] = mediaPonderada(valores[i], qtd);

    // Detalhes
    printf("\n--- Dados dos participantes (ordem alfabetica) ---\n");
    for (i = 0; i < N_PART; i++)
        printf("%-15s ID: %-20llu Media ponderada: %.2f\n", nomes[i], ids[i], media[i]);

    if (achouDiagonal)
        printf("\nLados do retangulo: %.2f e %.2f  ->  diagonal = %.2f\n", ladoRet[0], ladoRet[1], diagonal);
    else
        printf("\nNao foi possivel calcular a diagonal (menos de dois valores nao negativos).\n");

    // 6) e 7) Classificacao final
    printf("\n========== CLASSIFICACAO FINAL ==========\n\n");
    for (i = 0; i < N_PART; i++)
    {
        for (j = 0; nomes[i][j] != '\0'; j++)
            maiusculo[j] = toupper((unsigned char)nomes[i][j]);
        maiusculo[j] = '\0';

        if (!achouDiagonal)
            classe = "SEM DIAGONAL";
        else if (media[i] > diagonal + EPS)
            classe = "ACIMA DA DIAGONAL";
        else if (media[i] < diagonal - EPS)
            classe = "ABAIXO DA DIAGONAL";
        else
            classe = "SOBRE A DIAGONAL";

        printf("%s ", maiusculo);
        for (j = (int) strlen(maiusculo); j < 20; j++)
            printf(".");
        printf(" %s\n", classe);
    }
    printf("\n=========================================\n");

    for (i = 0; i < N_PART; i++)
        free(valores[i]);
    free(valores);

    return 0;
}
