#include <stdio.h>
#include <stdlib.h>

#define QTD 15

int ehPrimo(int n)
{
    int i;

    if (n < 2)
        return 0;
    for (i = 2; i * i <= n; i++)
    {
        if (n % i == 0)
            return 0;
    }
    return 1;
}

int main()
{
    int v[QTD];
    int distintos[QTD], ocorr[QTD], primeiraPos[QTD], nDist = 0;
    int i, j, achou, soma, qtdAnimais, precisaAnimais = 0;
    char **animais = NULL;   // lista de animais (ponteiro para ponteiro)

    for (i = 0; i < QTD; i++)
    {
        printf("Digite o numero %d: ", i + 1);
        scanf("%d", &v[i]);
    }

    // a) Conta as ocorrencias e guarda a 1a posicao (1 a 15) de cada numero
    for (i = 0; i < QTD; i++)
    {
        achou = -1;
        for (j = 0; j < nDist; j++)
        {
            if (distintos[j] == v[i])
                achou = j;
        }
        if (achou == -1)
        {
            distintos[nDist] = v[i];
            ocorr[nDist] = 1;
            primeiraPos[nDist] = i + 1;
            nDist++;
        }
        else
        {
            ocorr[achou]++;
        }
    }

    // Tabela de classificacao
    printf("\n%-8s %-12s %s\n", "Numero", "Ocorrencias", "Classificacao");
    for (j = 0; j < nDist; j++)
    {
        printf("%-8d %-12d ", distintos[j], ocorr[j]);
        if (ocorr[j] == 1)
            printf("Nao repetido\n");
        else if (ehPrimo(distintos[j]))
            printf("%s\n", (ocorr[j] % 2 != 0) ? "Primo - impar" : "Primo - par");
        else
            printf("%s\n", (ocorr[j] % 2 != 0) ? "Impar" : "Par");

        // So numeros repetidos entram nas regras b) e c)
        if (ocorr[j] > 1 && ((ehPrimo(distintos[j]) && ocorr[j] % 2 != 0) || ocorr[j] % 2 == 0))
            precisaAnimais = 1;
    }

    // Cadastro dos animais (a posicao na lista = codigo do animal)
    if (precisaAnimais)
    {
        printf("\nQuantos animais deseja cadastrar? ");
        scanf("%d", &qtdAnimais);
        if (qtdAnimais < 0)
            qtdAnimais = 0;

        animais = (char **) malloc((qtdAnimais > 0 ? qtdAnimais : 1) * sizeof(char *));
        for (i = 0; i < qtdAnimais; i++)
        {
            animais[i] = (char *) malloc(50 * sizeof(char));
            printf("Nome do animal %d: ", i + 1);
            scanf(" %49[^\n]", animais[i]);
        }

        printf("\n=== Animais correspondentes ===\n");

        // b) Primos com quantidade IMPAR de ocorrencias: soma de todas as ocorrencias = codigo
        printf("\nPrimos com ocorrencias impares (codigo = soma das ocorrencias):\n");
        for (j = 0; j < nDist; j++)
        {
            if (ocorr[j] > 1 && ehPrimo(distintos[j]) && ocorr[j] % 2 != 0)
            {
                soma = distintos[j] * ocorr[j];
                printf("  Numero %d (soma %d): ", distintos[j], soma);
                if (soma >= 1 && soma <= qtdAnimais)
                    printf("%s.\n", animais[soma - 1]);
                else
                    printf("Nao existe correspondencia.\n");
            }
        }

        // c) Quantidade PAR de ocorrencias: posicao no vetor = codigo
        printf("\nOcorrencias pares (codigo = posicao no vetor):\n");
        for (j = 0; j < nDist; j++)
        {
            if (ocorr[j] % 2 == 0)
            {
                printf("  Numero %d (posicao %d): ", distintos[j], primeiraPos[j]);
                if (primeiraPos[j] >= 1 && primeiraPos[j] <= qtdAnimais)
                    printf("%s.\n", animais[primeiraPos[j] - 1]);
                else
                    printf("Nao existe correspondencia.\n");
            }
        }

        for (i = 0; i < qtdAnimais; i++)
            free(animais[i]);
        free(animais);
    }
    else
    {
        printf("\nNenhum numero se enquadra nas regras de correspondencia.\n");
    }

    return 0;
}
